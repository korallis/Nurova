# Copy to .env.local and fill in. In Vercel, set the same values under
# Settings → Environment Variables (adding Neon and Blob storage sets some for you).

# Neon Postgres connection string (pooled). Without it, the site shows its built-in content.
DATABASE_URL=
# Optional: Neon's direct (non-pooled) connection string, used for migrations.
DATABASE_URL_UNPOOLED=

# Signs dashboard sessions and encrypts the email secret. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Vercel Blob, for image uploads from the dashboard.
BLOB_READ_WRITE_TOKEN=

# Optional: Microsoft Graph email. Can be entered in the dashboard (Settings → Email) instead.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SENDER_ID=
